{
  "version": 8,
  "name": "Per-file styles for multiple-layers.zip",
  "sources": {
    "places": {},
    "parks": {},
    "routes": {}
  },
  "layers": [
    {
      "id": "places-circles",
      "source": "places",
      "type": "circle",
      "paint": { "circle-color": "#2563eb", "circle-radius": 9, "circle-stroke-color": "#ffffff", "circle-stroke-width": 2 }
    },
    {
      "id": "places-labels",
      "source": "places",
      "type": "symbol",
      "layout": { "text-field": ["to-string", ["get", "name"]], "text-size": 14, "text-offset": [0, 1.2] },
      "paint": { "text-color": "#1e3a8a", "text-halo-color": "#ffffff", "text-halo-width": 2 }
    },
    {
      "id": "parks-fill",
      "source": "parks",
      "type": "fill",
      "paint": { "fill-color": "#22c55e", "fill-opacity": 0.5, "fill-outline-color": "#14532d" }
    },
    {
      "id": "routes-line",
      "source": "routes",
      "type": "line",
      "paint": { "line-color": "#f97316", "line-width": 6, "line-opacity": 0.9 }
    }
  ]
}
